{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "artifacts/api-server/tsconfig.json",
  "mutate": [
    "artifacts/api-server/src/lexassist/sessions.ts",
    "artifacts/api-server/src/lexassist/stripe-billing.ts"
  ],
  "vitest": {
    "configFile": "vitest.coverage.mts"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  },
  "reporters": ["clear-text", "html", "json"],
  "htmlReporter": {
    "fileName": "test-results/stryker/index.html"
  },
  "ignoreStatic": true,
  "concurrency": 2,
  "timeoutMS": 60000
}
