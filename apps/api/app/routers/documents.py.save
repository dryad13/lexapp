from __future__ import annotations

import os
import uuid
from datetime import datetime, timezone

from fastapi import APIRouter, Depends, File, UploadFile, HTTPException, Request
from fastapi.responses import FileResponse
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from app.config import settings
from app.db import get_db
from app.deps import require_roles
from app.models import Document, Matter, OnboardingRequest
from app.schemas import DocumentOut
from app.storage import LocalStorage
from app.audit import audit
from app.rate_limit import limiter, ONBOARD_LIMIT

router = APIRouter(prefix="/documents", tags=["documents"])

storage = LocalStorage(settings.upload_dir)

ALLOWED_MIME = {
    "application/pdf": ".pdf",
    "image/jpeg": ".jpg",
    "image/png": ".png",
}


def _size_limit() -> int:
    return int(settings.max_upload_mb) * 1024 * 1024


async def _read_limited(file: UploadFile) -> bytes:
    content = await file.read()
    if len(content) > _size_limit():
        raise HTTPException(status_code=413, detail="File too large")
    return content


@router.post("/matters/{matter_id}/upload", response_model=DocumentOut)
async def staff_upload(
    matter_id: uuid.UUID,
    category: str,
    file: UploadFile = File(...),
    db: AsyncSession = Depends(get_db),
    user=Depends(require_roles("ADMIN", "FEE_EARNER", "ASSISTANT")),
):
    mr = await db.execute(select(Matter).where(Matter.id == matter_id, Matter.firm_id == user.firm_id))
    matter = mr.scalar_one_or_none()
    if not matter:
        raise HTTPException(status_code=404, detail="Matter not found")

    if file.content_type not in ALLOWED_MIME:
        raise HTTPException(status_code=415, detail="Unsupported file type")

    content = await _read_limited(file)
    stored = storage.save_bytes(content, ALLOWED_MIME[file.content_type])

    now = datetime.now(timezone.utc)
    doc = Document(
        id=uuid.uuid4(),
        matter_id=matter.id,
        uploader_user_id=user.id,
        category=category,
        original_filename=os.path.basename(file.filename or "upload"),
        stored_filename=stored.stored_filename,
        mime_type=file.content_type,
        size_bytes=len(content),
        created_at=now,
    )
    db.add(doc)
    await db.commit()

    await audit(db, firm_id=user.firm_id, actor=user, action="DOCUMENT_UPLOADED", entity_type="Document", entity_id=str(doc.id), metadata={"category": category})

    return DocumentOut(
        id=doc.id,
        matter_id=doc.matter_id,
        category=doc.category,  # type: ignore
        original_filename=doc.original_filename,
        mime_type=doc.mime_type,
        size_bytes=doc.size_bytes,
        created_at=doc.created_at,
        download_url=f"/api/v1/documents/{doc.id}/download",
    )


@router.post("/client/{token}/upload", response_model=DocumentOut)
@limiter.limit(ONBOARD_LIMIT)
async def client_upload(
    request: Request,
    token: str,
    category: str,
    backup_code: str | None = None,
    file: UploadFile = File(...),
    db: AsyncSession = Depends(get_db),
):
    rr = await db.execute(select(OnboardingRequest).where(OnboardingRequest.token == token))
    req = rr.scalar_one_or_none()
    if not req:
        raise HTTPException(status_code=404, detail="Invalid link")
    if req.expires_at < datetime.now(timezone.utc):
        raise HTTPException(status_code=410, detail="Link expired")
    if req.backup_code and backup_code and req.backup_code != backup_code:
        raise HTTPException(status_code=401, detail="Invalid backup code")

    if file.content_type not in ALLOWED_MIME:
        raise HTTPException(status_code=415, detail="Unsupported file type")

    content = await _read_limited(file)
    stored = storage.save_bytes(content, ALLOWED_MIME[file.content_type])

    now = datetime.now(timezone.utc)
    doc = Document(
        id=uuid.uuid4(),
        matter_id=req.matter_id,
        uploader_user_id=None,
        category=category,
        original_filename=os.path.basename(file.filename or "upload"),
        stored_filename=stored.stored_filename,
        mime_type=file.content_type,
        size_bytes=len(content),
        created_at=now,
    )
    db.add(doc)
    await db.commit()

    matter = await db.get(Matter, req.matter_id)
    await audit(db, firm_id=matter.firm_id, actor=None, action="CLIENT_DOCUMENT_UPLOADED", entity_type="Document", entity_id=str(doc.id), metadata={"category": category})

    return DocumentOut(
        id=doc.id,
        matter_id=doc.matter_id,
        category=doc.category,  # type: ignore
        original_filename=doc.original_filename,
        mime_type=doc.mime_type,
        size_bytes=doc.size_bytes,
        created_at=doc.created_at,
        download_url=f"/api/v1/documents/{doc.id}/download",
    )


@router.get("/{doc_id}/download")
async def download(
    doc_id: uuid.UUID,
    db: AsyncSession = Depends(get_db),
    user=Depends(require_roles("ADMIN", "FEE_EARNER", "ASSISTANT")),
):
    doc = await db.get(Document, doc_id)
    if not doc:
        raise HTTPException(status_code=404, detail="Not found")

    matter = await db.get(Matter, doc.matter_id)
    if not matter or matter.firm_id != user.firm_id:
        raise HTTPException(status_code=403, detail="Forbidden")

    path = storage.open_path(doc.stored_filename)
    return FileResponse(path, media_type=doc.mime_type, filename=doc.original_filename)
