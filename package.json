{
  "name": "uk-legal-onboarding-mvp",
  "private": true,
  "workspaces": [
    "apps/firm-portal",
    "apps/client-portal",
    "packages/shared"
  ],
  "scripts": {
    "dev:firm": "npm --workspace apps/firm-portal run dev",
    "dev:client": "npm --workspace apps/client-portal run dev",
